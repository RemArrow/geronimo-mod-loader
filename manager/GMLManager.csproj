<Project Sdk="Microsoft.NET.Sdk">
  <!-- GML Manager: installs/updates the Geronimo Mod Loader and its mods.
       .NET Framework 4.8 ships with Windows 10/11, so the result is one small exe with nothing
       else to install. Build: dotnet build -c Release  (build.bat at the repo root does it too). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>GMLManager</AssemblyName>
    <RootNamespace>GMLManager</RootNamespace>
    <Version>2.4.0</Version>
    <Product>GML Manager</Product>
    <Company>RemArrow</Company>
    <Copyright>RemArrow</Copyright>
    <Description>Installs and updates the Geronimo Mod Loader and its mods</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>gml.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DebugType>embedded</DebugType>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- the catalog shipped inside the exe: used when GitHub can't be reached -->
    <EmbeddedResource Include="..\catalog.json" LogicalName="catalog.json" />
    <!-- the SDK headers, for "New plugin project" -->
    <EmbeddedResource Include="..\include\GML\GML.h" LogicalName="sdk/GML.h" />
    <EmbeddedResource Include="..\include\GML\GML.hpp" LogicalName="sdk/GML.hpp" />
    <Resource Include="gml.ico" />
  </ItemGroup>
</Project>
