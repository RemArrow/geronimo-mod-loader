<Window x:Class="GMLManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GML Manager" Width="980" Height="700" MinWidth="760" MinHeight="520"
        Background="{StaticResource Bg}" Foreground="{StaticResource Fg}" FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" WindowStartupLocation="CenterScreen"
        Icon="gml.ico">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- header: the loader and Play -->
    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="22,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="0" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock FontSize="20" FontWeight="Bold">
            <Run Text="GML" Foreground="{StaticResource Accent}" /><Run Text=" Manager" />
          </TextBlock>
          <TextBlock x:Name="GameText" Foreground="{StaticResource FgDim}" FontSize="12" Text="Looking for Geronimo…"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
          <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
            <TextBlock x:Name="LoaderText" HorizontalAlignment="Right" FontWeight="SemiBold" Text="Loader" />
            <TextBlock x:Name="LoaderSub" HorizontalAlignment="Right" Style="{StaticResource Dim}" FontSize="12" />
          </StackPanel>
          <Button x:Name="LoaderButton" Click="OnLoaderButton" Visibility="Collapsed" Style="{StaticResource AccentButton}" />
          <CheckBox x:Name="ModsSwitch" Content="Mods on" Click="OnModsSwitch" Margin="8,0,0,0"
                    ToolTip="Off: the game starts without GML and every mod (doorstop_config.ini enabled = false)" />
        </StackPanel>

        <Button x:Name="PlayButton" Grid.Column="3" Style="{StaticResource AccentButton}" Click="OnPlay"
                FontSize="16" Padding="26,10" Margin="0" MinWidth="130">
          <TextBlock x:Name="PlayText" Text="▶  PLAY" Foreground="{StaticResource AccentFg}" FontWeight="Bold" />
        </Button>
      </Grid>
    </Border>

    <!-- banner: one message that needs the user (game not found, loader missing, ...) -->
    <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Background="#FF2D2516" BorderBrush="#FF5A4520"
            BorderThickness="0,0,0,1" Padding="22,10">
      <DockPanel>
        <Button x:Name="BannerButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Click="OnBannerButton" Margin="12,0,0,0" />
        <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
      </DockPanel>
    </Border>

    <TabControl x:Name="Tabs" Grid.Row="2" Margin="12,8,12,0" SelectionChanged="OnTabChanged">
      <!-- ================================================================ Mods -->
      <TabItem Header="Mods">
        <DockPanel Margin="10,12,10,0">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Install from file…" Click="OnInstallFile" />
            <Button Content="Check for updates" Click="OnCheckUpdates" />
            <Button Content="Plugins folder" Click="OnOpenPlugins" />
            <TextBlock Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0" TextAlignment="Right"
                       Text="Or drop a mod's .zip or .dll on this window" />
          </DockPanel>
          <TextBlock x:Name="NoPlugins" DockPanel.Dock="Top" Style="{StaticResource Dim}" Visibility="Collapsed" Margin="2,8"
                     Text="No mods installed yet. Find some in the Browse tab." />
          <ListBox x:Name="PluginList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}" ToolTip="{Binding Tooltip}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnPluginSwitch" Tag="{Binding}"
                              VerticalAlignment="Center" Margin="0,0,14,0" ToolTip="Load this mod" />
                    <StackPanel Grid.Column="1" Opacity="{Binding Opacity}" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Version}" Foreground="{StaticResource FgDim}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                        <Border Style="{StaticResource Badge}" Background="#FF243447" Visibility="{Binding KindVisible}">
                          <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="{StaticResource Info}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#FF3A2F1A" Visibility="{Binding UpdateVisible}">
                          <TextBlock Text="update available" FontSize="11" Foreground="{StaticResource Accent}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#FF2A2D35" Visibility="{Binding LocalVisible}"
                                ToolTip="Not in the catalog: installed by hand or your own build. GML Manager never updates it.">
                          <TextBlock Text="local" FontSize="11" Foreground="{StaticResource FgDim}" />
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="#FF2A2D35" Visibility="{Binding DisabledVisible}">
                          <TextBlock Text="off" FontSize="11" Foreground="{StaticResource FgDim}" />
                        </Border>
                      </StackPanel>
                      <TextBlock Text="{Binding Guid}" Style="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0" />
                      <TextBlock Text="{Binding ProblemText}" Foreground="{StaticResource Bad}" FontSize="12" Margin="0,4,0,0"
                                 TextWrapping="Wrap" Visibility="{Binding ProblemVisible}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="{Binding UpdateText}" Visibility="{Binding UpdateVisible}" Style="{StaticResource AccentButton}"
                              Click="OnPluginUpdate" Tag="{Binding}" />
                      <Button Content="Settings" Visibility="{Binding SettingsVisible}" Click="OnPluginSettings" Tag="{Binding}" />
                      <Button Content="Folder" Click="OnPluginFolder" Tag="{Binding}" />
                      <Button Content="Remove" Style="{StaticResource DangerButton}" Click="OnPluginRemove" Tag="{Binding}" Margin="0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ================================================================ Browse -->
      <TabItem Header="Browse">
        <DockPanel Margin="10,12,10,0">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <Button Content="Refresh" Click="OnCheckUpdates" DockPanel.Dock="Right" Margin="0" />
            <TextBlock x:Name="CatalogSource" Style="{StaticResource Dim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <ListBox x:Name="CatalogList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource Card}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Author}" Style="{StaticResource Dim}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
                      </StackPanel>
                      <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,6,0,0" />
                      <TextBlock Text="{Binding Credits}" Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,0"
                                 Visibility="{Binding CreditsVisible}" />
                      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding LatestText}" Style="{StaticResource Dim}" FontSize="12" />
                        <TextBlock Text="{Binding Tags}" Foreground="{StaticResource Info}" FontSize="12" Margin="14,0,0,0" />
                        <Button Content="Page" Style="{StaticResource LinkButton}" Click="OnCatalogPage" Tag="{Binding}" Margin="14,0,0,0" FontSize="12" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="130">
                      <Button Content="{Binding ActionText}" IsEnabled="{Binding CanInstall}" Click="OnCatalogInstall" Tag="{Binding}" Margin="0"
                              Style="{StaticResource AccentButton}" Visibility="{Binding ButtonVisible}" />
                      <TextBlock Text="Installed ✓" Foreground="{StaticResource Good}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                 Visibility="{Binding InstalledVisible}" />
                      <TextBlock Text="{Binding InstalledText}" Style="{StaticResource Dim}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ================================================================ Developer -->
      <TabItem Header="Developer">
        <Grid Margin="10,12,10,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="290" />
          </Grid.ColumnDefinitions>
          <DockPanel Margin="0,0,14,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Log" Style="{StaticResource H2}" Margin="0,0,12,0" VerticalAlignment="Center" />
              <Button Content="Open file" DockPanel.Dock="Right" Click="OnOpenLog" Margin="0" />
              <CheckBox x:Name="LogFollow" Content="Follow" IsChecked="True" DockPanel.Dock="Right" Margin="0,0,12,0" />
              <CheckBox x:Name="LogProblems" Content="Problems only" DockPanel.Dock="Right" Margin="0,0,12,0" Click="OnLogFilter" />
              <TextBox x:Name="LogFilter" Margin="0,0,12,0" TextChanged="OnLogFilter" ToolTip="Show lines containing this text" />
            </DockPanel>
            <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="NoWrap"
                     VerticalContentAlignment="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     Background="#FF0F1115" />
          </DockPanel>

          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Loader settings" Style="{StaticResource H2}" />
              <TextBlock x:Name="GmlCfgNote" Style="{StaticResource Dim}" FontSize="12" Margin="0,0,0,8"
                         Text="GML.cfg appears after the game's first launch with GML." Visibility="Collapsed" />
              <StackPanel x:Name="GmlSwitches">
                <CheckBox x:Name="CfgConsole" Content="Console window" Click="OnGmlCfg" Tag="Logging.Console|Enabled" Margin="0,0,0,8"
                          ToolTip="A console mirroring the log, for flat-screen debugging" />
                <CheckBox x:Name="CfgTimestamps" Content="Timestamps in the log" Click="OnGmlCfg" Tag="Logging.Disk|Timestamps" Margin="0,0,0,8" />
                <CheckBox x:Name="CfgTrace" Content="Trace ProcessEvent" Click="OnGmlCfg" Tag="Engine|TraceProcessEvent" Margin="0,0,0,8"
                          ToolTip="Log every distinct UFunction once: for finding hook targets" />
                <CheckBox x:Name="CfgPaks" Content="Deploy plugin paks" Click="OnGmlCfg" Tag="Paks|Sync" Margin="0,0,0,8" />
                <CheckBox x:Name="CfgMods" Content="Deploy Unreal mod plugins" Click="OnGmlCfg" Tag="Mods|Sync" Margin="0,0,0,8" />
                <DockPanel Margin="0,2,0,8">
                  <TextBlock Text="Log level" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ComboBox x:Name="CfgLevel" SelectionChanged="OnGmlLevel">
                    <ComboBoxItem>Debug</ComboBoxItem>
                    <ComboBoxItem>Info</ComboBoxItem>
                    <ComboBoxItem>Message</ComboBoxItem>
                    <ComboBoxItem>Warning</ComboBoxItem>
                    <ComboBoxItem>Error</ComboBoxItem>
                  </ComboBox>
                </DockPanel>
                <Button Content="All loader settings…" Click="OnGmlAllSettings" HorizontalAlignment="Left" />
              </StackPanel>

              <TextBlock Text="Launch" Style="{StaticResource H2}" Margin="0,18,0,8" />
              <CheckBox x:Name="FlatMode" Content="Flat screen (-nohmd)" Click="OnFlatMode" Margin="0,0,0,8"
                        ToolTip="Start without VR. Steam asks once to allow launch arguments." />
              <TextBlock Text="Extra arguments" Style="{StaticResource Dim}" FontSize="12" />
              <TextBox x:Name="LaunchArgs" Margin="0,4,0,0" LostFocus="OnLaunchArgs" />

              <TextBlock Text="Make a plugin" Style="{StaticResource H2}" Margin="0,18,0,8" />
              <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,0,0,8"
                         Text="A ready-to-build C++ plugin folder: source, the SDK headers and a build.bat that installs into this game." />
              <Button Content="New plugin project…" Click="OnNewPlugin" HorizontalAlignment="Left" />
              <Button Content="Plugin docs" Style="{StaticResource LinkButton}" Click="OnDocs" HorizontalAlignment="Left" Margin="0,8,0,0" />

              <TextBlock Text="Folders" Style="{StaticResource H2}" Margin="0,18,0,8" />
              <WrapPanel>
                <Button Content="Game" Click="OnOpenFolder" Tag="" Margin="0,0,6,6" />
                <Button Content="GML" Click="OnOpenFolder" Tag="GML" Margin="0,0,6,6" />
                <Button Content="Config" Click="OnOpenFolder" Tag="GML\config" Margin="0,0,6,6" />
                <Button Content="Patchers" Click="OnOpenFolder" Tag="GML\patchers" Margin="0,0,6,6" />
              </WrapPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <!-- ================================================================ Settings -->
      <TabItem Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="10,12,10,12" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="Game folder" Style="{StaticResource H2}" />
            <DockPanel>
              <Button Content="Find" DockPanel.Dock="Right" Click="OnFindGame" Margin="6,0,0,0" />
              <Button Content="Browse…" DockPanel.Dock="Right" Click="OnBrowseGame" Margin="6,0,0,0" />
              <TextBox x:Name="GameDirBox" IsReadOnly="True" />
            </DockPanel>
            <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0"
                       Text="The folder holding Geronimo-Win64-Shipping.exe (Geronimo\Binaries\Win64). Found through Steam by itself." />

            <TextBlock Text="Updates" Style="{StaticResource H2}" Margin="0,22,0,8" />
            <CheckBox x:Name="AutoUpdate" Content="Update the loader and my mods when GML Manager starts" Click="OnSettingChanged" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="44,0,0,10"
                       Text="Only what GML Manager installed: a mod or loader you built and copied in yourself is never replaced (it shows an Update button when the catalog has a newer release)." />
            <CheckBox x:Name="UpdateSelf" Content="Update GML Manager itself" Click="OnSettingChanged" Margin="0,0,0,10" />
            <CheckBox x:Name="Prereleases" Content="Include pre-releases" Click="OnSettingChanged" Margin="0,0,0,10" />
            <CheckBox x:Name="CloseOnPlay" Content="Close GML Manager when the game starts" Click="OnSettingChanged" Margin="0,0,0,10" />

            <TextBlock Text="Catalog" Style="{StaticResource H2}" Margin="0,16,0,8" />
            <TextBox x:Name="CatalogUrlBox" LostFocus="OnCatalogUrl" />
            <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,4,0,0"
                       Text="Empty = the official catalog. Mod authors: a URL or local path to your own catalog.json to try an entry before opening a pull request." />

            <TextBlock Text="Loader" Style="{StaticResource H2}" Margin="0,22,0,8" />
            <WrapPanel>
              <Button x:Name="ReinstallLoader" Content="Reinstall latest" Click="OnReinstallLoader" Margin="0,0,6,6" />
              <Button Content="Uninstall loader" Style="{StaticResource DangerButton}" Click="OnUninstallLoader" Margin="0,0,6,6" />
              <Button Content="Clear update cache" Click="OnClearCache" Margin="0,0,6,6" />
            </WrapPanel>
            <TextBlock Style="{StaticResource Dim}" FontSize="12" Margin="0,2,0,0"
                       Text="Uninstalling removes the loader and what it deployed. Your mods (GML\plugins) and their settings stay, so reinstalling brings them back." />

            <TextBlock x:Name="AboutText" Style="{StaticResource Dim}" FontSize="12" Margin="0,26,0,0" />
            <Button Content="github.com/RemArrow/geronimo-mod-loader" Style="{StaticResource LinkButton}" Click="OnDocs" HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="12" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- status bar -->
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,6">
      <DockPanel>
        <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="180" Height="6" Visibility="Collapsed"
                     Background="#FF2A2E37" Foreground="{StaticResource Accent}" BorderThickness="0" Maximum="1" />
        <TextBlock x:Name="StatusText" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
  </Grid>
</Window>
