#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    GML_VERSION_MAJOR, GML_VERSION_MINOR, GML_VERSION_PATCH, 0
 PRODUCTVERSION GML_VERSION_MAJOR, GML_VERSION_MINOR, GML_VERSION_PATCH, 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "RemArrow"
      VALUE "FileDescription",  "Geronimo Mod Loader"
      VALUE "FileVersion",      GML_VERSION_STRING
      VALUE "ProductName",      "Geronimo Mod Loader"
      VALUE "ProductVersion",   GML_VERSION_STRING
      VALUE "OriginalFilename", "GML.dll"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
